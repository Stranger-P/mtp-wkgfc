# ---- LLM ------------------------------------------------------------------
# LLM_BACKEND: gemini (free, testing) | bedrock (Claude, thesis numbers)
LLM_BACKEND=gemini

# (a) Google Gemini, free tier from Google AI Studio (development/testing only)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash,gemini-3.8-flash

GEMINI_API_KEY=

# (b) Claude on Amazon Bedrock (use for final thesis numbers)
#  Working IDs on this account: us./global. + anthropic.claude-haiku-4-5-20251001-v1:0 | anthropic.claude-sonnet-4-6
#                               | anthropic.claude-opus-4-6-v1 | anthropic.claude-opus-4-5-20251101-v1:0
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
#  Fallbacks: same model via the global profile first (identical model, more capacity), then Sonnet 4.6.
#  Thesis runs: pass --fallback-models "" so every number comes from one model.
BEDROCK_FALLBACK_MODELS=global.anthropic.claude-haiku-4-5-20251001-v1:0,us.anthropic.claude-sonnet-4-6,global.anthropic.claude-sonnet-4-6
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# (or instead of the two keys above:) AWS_BEARER_TOKEN_BEDROCK=

# ---- (alternative) OpenAI ------------------------------------------------
# LLM_BACKEND=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# ---- Web search (step 2) ---------------------------------------------------
SERPER_API_KEY=

# ---- Wikidata (no key; just identify yourself) -----------------------------
WIKIDATA_USER_AGENT=MTP-WKGFC/0.1 (your.email@iiitm.ac.in)
